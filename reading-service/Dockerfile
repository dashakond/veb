# Вказуємо офіційний образ Node.js
FROM node:16

# Встановлюємо робочий каталог всередині контейнера
WORKDIR /usr/src/app

# Копіюємо package.json і package-lock.json для встановлення залежностей
COPY package*.json ./

# Встановлюємо залежності сервісу
RUN npm install

# Копіюємо всі файли проекту до контейнера
COPY . .

# Відкриваємо порт, на якому працює додаток
EXPOSE 3003

# Команда для запуску сервісу
CMD ["npm", "start"]
